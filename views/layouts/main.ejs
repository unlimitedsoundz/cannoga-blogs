<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' && title ? title : 'Cannoga College Blog' %></title>
    <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
    <% } %>
    <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= metaDescription || '' %>">
    <meta property="og:type" content="article">
    <% } %>
    <link href="/css/output.css?v=<%= Math.random() %>" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>
<body class="min-h-screen bg-white pt-28">
    <!-- Header - Matching Cannoga College Main Site -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-sm w-full font-sans border-b border-neutral-200">
        <!-- Top Utility Bar (Desktop) -->
        <div class="hidden lg:block bg-[#0f2027] text-slate-200 text-xs h-9 w-full border-b border-[#1e3a47]">
