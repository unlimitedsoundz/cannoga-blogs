                                    <a href="https://cannogacollege.ca/schools/technology" class="block px-2 py-1.5 text-xs text-slate-700 hover:text-black hover:bg-neutral-200/60 rounded">School of Technology</a>
                                    <a href="https://cannogacollege.ca/schools/health-community" class="block px-2 py-1.5 text-xs text-slate-700 hover:text-black hover:bg-neutral-200/60 rounded">School of Health & Community Services</a>
                                    <a href="https://cannogacollege.ca/schools/hospitality-tourism" class="block px-2 py-1.5 text-xs text-slate-700 hover:text-black hover:bg-neutral-200/60 rounded">School of Hospitality & Tourism</a>
                                    <a href="https://cannogacollege.ca/schools/education-social-sciences" class="block px-2 py-1.5 text-xs text-slate-700 hover:text-black hover:bg-neutral-200/60 rounded">School of Education & Social Sciences</a>
                                    <a href="https://cannogacollege.ca/schools/transportation-aviation" class="block px-2 py-1.5 text-xs text-slate-700 hover:text-black hover:bg-neutral-200/60 rounded">School of Transportation & Aviation</a>
