<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' && title ? title : 'Cannoga College Blog | Student Stories & News' %></title>
    <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
    <% } else { %>
    <meta name="description" content="Discover student stories, campus news, and international student insights at Cannoga College in Ottawa, Ontario, Canada.">
    <% } %>
    <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : '' %>">
    <meta property="og:type" content="article">
    <% } %>
    <link href="/css/output.css?v=<%= Math.random() %>" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>
<body class="min-h-screen bg-white pt-20 font-sans antialiased text-black">
    <!-- Blog-Only Header in Deep Blue (#0a151a) - Stroke Free -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0a151a] text-white shadow-md w-full font-sans border-0">
        <div class="container mx-auto px-4 max-w-7xl h-20 flex items-center justify-between">
            <!-- Left Branding -->
            <div class="flex items-center gap-4">
                <a href="https://cannogacollege.ca/" class="flex items-center group">
                    <img src="/images/logo-cannoga.png" alt="Cannoga College" width="180" height="48" class="h-10 md:h-12 w-auto object-contain shrink-0 brightness-0 invert" />
                </a>
                <span class="hidden sm:inline-block w-px h-6 bg-white/20"></span>
                <a href="/" class="flex items-center gap-2 no-underline">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-[#0a151a] bg-[#c89211] hover:bg-[#b07f0e] px-3 py-1.5 rounded-full transition-colors shadow-xs">
                        Student Blog
                    </span>
                </a>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8">
                <a href="/" class="text-sm font-bold text-white hover:text-[#c89211] transition-colors no-underline">All Posts</a>
                <a href="https://cannogacollege.ca/" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors no-underline">College Home</a>
                <a href="https://cannogacollege.ca/studies" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors no-underline">Programmes</a>
                <a href="https://cannogacollege.ca/admissions" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors no-underline">Admissions</a>
                <a href="https://cannogacollege.ca/student-guide/international" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors no-underline">International</a>
            </nav>

            <!-- Right Actions (Search & Apply CTA) -->
            <div class="hidden sm:flex items-center gap-4">
                <form action="/" method="GET" class="relative flex items-center">
                    <input 
                        type="text" 
                        name="search" 
                        placeholder="Search articles..." 
                        class="w-40 focus:w-56 transition-all duration-200 px-3.5 py-2 text-xs bg-white/10 text-white placeholder-slate-400 border-0 rounded-full focus:outline-none focus:bg-white/20 focus:ring-1 focus:ring-[#c89211]"
                    />
                    <button type="submit" class="absolute right-3 text-slate-300 hover:text-white">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </button>
                </form>
                <a href="https://cannogacollege.ca/admissions/application-process" class="bg-[#c89211] hover:bg-[#b07f0e] text-[#0a151a] px-5 py-2.5 rounded-full text-xs font-bold tracking-wide transition-colors shadow-xs no-underline">
                    Apply Now
                </a>
            </div>

            <!-- Mobile Toggle -->
            <div class="md:hidden flex items-center gap-2">
                <button id="mobile-menu-btn" class="p-2 text-white hover:text-[#c89211] focus:outline-none" aria-label="Toggle Menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Backdrop -->
    <div id="mobile-menu-backdrop" class="hidden fixed inset-0 bg-black/60 z-40 md:hidden"></div>

    <!-- Mobile Menu Drawer -->
    <div id="mobile-menu" class="hidden fixed top-20 left-0 right-0 bottom-0 bg-[#0a151a] text-white z-50 overflow-y-auto px-6 py-6 border-0 md:hidden font-sans">
        <div class="flex flex-col gap-4">
            <a href="/" class="text-base font-bold text-white no-underline py-2 border-b border-white/10">All Blog Posts</a>
            <a href="https://cannogacollege.ca/" class="text-base font-bold text-slate-200 no-underline py-2 border-b border-white/10">Cannoga College Home</a>
            <a href="https://cannogacollege.ca/studies" class="text-base font-bold text-slate-200 no-underline py-2 border-b border-white/10">Explore Programmes</a>
            <a href="https://cannogacollege.ca/admissions" class="text-base font-bold text-slate-200 no-underline py-2 border-b border-white/10">Admissions & Apply</a>
            <a href="https://cannogacollege.ca/student-guide/international" class="text-base font-bold text-slate-200 no-underline py-2 border-b border-white/10">International Students</a>
            <a href="https://cannogacollege.ca/housing" class="text-base font-bold text-slate-200 no-underline py-2 border-b border-white/10">Student Housing</a>
            <a href="https://cannogacollege.ca/admissions/application-process" class="bg-[#c89211] text-[#0a151a] px-6 py-3.5 rounded-full text-center font-bold tracking-wider uppercase text-xs mt-4 no-underline shadow-xs">
                Apply to Cannoga College
            </a>
        </div>
    </div>

    <!-- Main View Content -->
    <%- body %>

    <!-- Footer - Deep Blue (#0a151a) -->
    <footer class="bg-[#0a151a] text-white pt-16 pb-10 font-sans mt-16 border-0">
        <div class="container mx-auto px-4 max-w-7xl">
            <!-- Top Row: Brand + Land Acknowledgement + Social -->
            <div class="mb-12 pb-10 border-b border-white/10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
                <div class="flex flex-col md:flex-row md:items-center gap-6 max-w-4xl">
                    <a href="https://cannogacollege.ca/" class="shrink-0">
                        <img src="/images/logo-cannoga.png" alt="Cannoga College" width="220" height="60" class="h-16 md:h-20 w-auto object-contain brightness-0 invert" />
                    </a>
                    <div class="text-xs text-white/80 leading-relaxed border-t md:border-t-0 md:border-l border-white/10 pt-4 md:pt-0 md:pl-6">
                        <span class="font-semibold block text-white mb-1 uppercase tracking-wider text-[10px]">Land Acknowledgement</span>
                        Cannoga College acknowledges that its campus in Ottawa is located on the traditional and unceded territory of the Anishinaabe Algonquin Nation. We honour the enduring presence, history, cultures, and contributions of First Nations, Inuit, and Métis peoples and recognize their continued connection to these lands.
                    </div>
                </div>
                <div class="flex space-x-5 shrink-0 items-center">
                    <a href="https://www.youtube.com/@CannogaCollege" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-white hover:text-[#c89211] hover:scale-110 transition-all transform inline-block">
                        <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    </a>
                    <a href="https://www.tiktok.com/@cannoga_college" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-white hover:text-[#c89211] hover:scale-110 transition-all transform inline-block">
                        <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                    </a>
                </div>
            </div>

            <!-- Link Columns -->
            <div class="grid grid-cols-2 md:grid-cols-5 gap-y-10 gap-x-6 mb-12">
                <!-- Study -->
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-widest mb-5 text-white">Study</h3>
                    <ul class="space-y-3">
                        <li><a href="https://cannogacollege.ca/studies" class="text-white text-sm hover:underline no-underline">All Courses</a></li>
                        <li><a href="https://cannogacollege.ca/admissions" class="text-white text-sm hover:underline no-underline">Admissions</a></li>
                        <li><a href="https://cannogacollege.ca/housing" class="text-white text-sm hover:underline no-underline">Student Housing</a></li>
                        <li><a href="https://cannogacollege.ca/admissions/tuition" class="text-white text-sm hover:underline no-underline">Scholarships</a></li>
                        <li><a href="https://cannogacollege.ca/student-guide/international" class="text-white text-sm hover:underline no-underline">International Students</a></li>
                    </ul>
                </div>

                <!-- About -->
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-widest mb-5 text-white">About</h3>
                    <ul class="space-y-3">
                        <li><a href="https://cannogacollege.ca/about" class="text-white text-sm hover:underline no-underline">Our Story</a></li>
                        <li><a href="https://cannogacollege.ca/news" class="text-white text-sm hover:underline no-underline">News & Events</a></li>
                        <li><a href="https://cannogacollege.ca/research" class="text-white text-sm hover:underline no-underline">Research</a></li>
                        <li><a href="https://cannogacollege.ca/student-life" class="text-white text-sm hover:underline no-underline">Campus Life</a></li>
                    </ul>
                </div>

                <!-- Resources -->
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-widest mb-5 text-white">Resources</h3>
                    <ul class="space-y-3">
                        <li><a href="https://cannogacollege.ca/admissions-policy" class="text-white text-sm hover:underline no-underline">Admissions Policy</a></li>
                        <li><a href="https://cannogacollege.ca/academic-regulations" class="text-white text-sm hover:underline no-underline">Academic Regulations</a></li>
                        <li><a href="https://cannogacollege.ca/student-handbook" class="text-white text-sm hover:underline no-underline">Student Handbook</a></li>
                        <li><a href="https://cannogacollege.ca/refund-withdrawal-policy" class="text-white text-sm hover:underline no-underline">Refund Policy</a></li>
                        <li><a href="https://cannogacollege.ca/code-of-conduct" class="text-white text-sm hover:underline no-underline">Code of Conduct</a></li>
                        <li><a href="https://cannogacollege.ca/alumni" class="text-white text-sm hover:underline no-underline">Alumni</a></li>
                        <li><a href="https://cannogacollege.ca/portal/support" class="text-white text-sm hover:underline no-underline">IT Support</a></li>
                        <li><a href="https://cannogacollege.ca/contact" class="text-white text-sm hover:underline no-underline">Contact Us</a></li>
                    </ul>
                </div>

                <!-- Explore -->
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-widest mb-5 text-white">Explore</h3>
                    <ul class="space-y-3">
                        <li><a href="https://cannogacollege.ca/admissions/requirements" class="text-white text-sm hover:underline no-underline">Admission Requirements</a></li>
                        <li><a href="https://cannogacollege.ca/admissions/contact-information" class="text-white text-sm hover:underline no-underline">Admissions Contact</a></li>
                        <li><a href="https://cannogacollege.ca/research/publications" class="text-white text-sm hover:underline no-underline">Publications</a></li>
                        <li><a href="https://cannogacollege.ca/innovation" class="text-white text-sm hover:underline no-underline">Innovation</a></li>
                        <li><a href="https://cannogacollege.ca/terms" class="text-white text-sm hover:underline no-underline">Terms of Use</a></li>
                        <li><a href="https://cannogacollege.ca/student-guide/chat-with-cannoga-students" class="text-white text-sm hover:underline no-underline">Chat with Students</a></li>
                    </ul>
                </div>

                <!-- Contact Info -->
                <div>
                    <h3 class="font-bold text-sm uppercase tracking-widest mb-5 text-white">Contact</h3>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3 text-white text-sm">
                            <svg class="w-4 h-4 text-white mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <div class="space-y-1">
                                <span class="block font-semibold text-white">Cannoga College – Ottawa campus</span>
                                <span class="block text-xs text-white/90">81 Montreal Rd,</span>
                                <span class="block text-xs text-white/90">K1L 6E8 Ottawa, Ontario, Canada</span>
                            </div>
                        </li>
                        <li class="flex items-center gap-3 text-white text-sm">
                            <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <a href="mailto:info@cannogacollege.ca" class="hover:underline text-white">info@cannogacollege.ca</a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Institutional & Accreditation Partner Logos -->
            <div class="pt-6 pb-6 flex flex-wrap items-center justify-center md:justify-start gap-8 md:gap-12 border-t border-white/10">
                <img src="https://ircc.com/icon.png" alt="IRCC Canada" class="h-9 md:h-11 w-auto object-contain brightness-0 invert opacity-85 hover:opacity-100 transition-opacity" />
                <img src="https://upload.wikimedia.org/wikipedia/en/3/36/OCAS_Logo_2026.png" alt="OCAS" class="h-9 md:h-11 w-auto object-contain brightness-0 invert opacity-85 hover:opacity-100 transition-opacity" />
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Ottawa%2C_City_of.svg/3840px-Ottawa%2C_City_of.svg.png" alt="City of Ottawa" class="h-9 md:h-11 w-auto object-contain brightness-0 invert opacity-85 hover:opacity-100 transition-opacity" />
                <img src="https://static.wikia.nocookie.net/logopedia/images/e/ea/Ontario1972.svg/revision/latest?cb=20241011133938" alt="Government of Ontario" class="h-9 md:h-11 w-auto object-contain brightness-0 invert opacity-85 hover:opacity-100 transition-opacity" />
            </div>

            <!-- Bottom Bar -->
            <div class="border-t border-white/10 pt-6">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                    <div class="text-slate-400 text-xs order-2 md:order-1 space-y-1 text-center md:text-left">
                        <p>© 2026 Cannoga College. All rights reserved.</p>
                        <p class="text-[11px] text-slate-500">Approved by Ontario Ministry of Colleges and Universities (MCU).</p>
                    </div>
                    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 order-1 md:order-2">
                        <a href="https://cannogacollege.ca/site-index" class="text-white text-xs hover:underline no-underline">Site Index</a>
                        <a href="https://cannogacollege.ca/privacy" class="text-white text-xs hover:underline no-underline">Privacy Policy</a>
                        <a href="https://cannogacollege.ca/terms" class="text-white text-xs hover:underline no-underline">Terms of Use</a>
                        <a href="https://cannogacollege.ca/cookies" class="text-white text-xs hover:underline no-underline">Cookie Policy</a>
                        <a href="https://cannogacollege.ca/accessibility" class="text-white text-xs hover:underline no-underline">Accessibility</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuBackdrop = document.getElementById('mobile-menu-backdrop');
            if (mobileMenuBtn && mobileMenu && mobileMenuBackdrop) {
                mobileMenuBtn.addEventListener('click', function() {
                    mobileMenu.classList.toggle('hidden');
                    mobileMenuBackdrop.classList.toggle('hidden');
                    document.body.classList.toggle('overflow-hidden');
                });
                mobileMenuBackdrop.addEventListener('click', function() {
                    mobileMenu.classList.add('hidden');
                    mobileMenuBackdrop.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                });
            }
        });
    </script>
</body>
</html>