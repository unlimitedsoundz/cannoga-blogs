                                <div class="space-y-1">
                                    <a href="https://cannogacollege.ca/schools/arts" class="block px-2 py-1.5 text-xs text-slate-700 hover:text-black hover:bg-neutral-200/60 rounded">School of Arts, Design and Architecture</a>
