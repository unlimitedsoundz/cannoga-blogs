                    <span class="text-slate-300">Designated Learning Institution (DLI)</span>
                </div>
                <div class="flex items-center gap-6">
                    <a href="https://cannogacollege.ca/housing" class="hover:text-white transition-colors">Student Housing</a>
                    <span class="text-slate-500">•</span>
                    <a href="https://cannogacollege.ca/portal/account/login" class="hover:text-white transition-colors font-semibold text-[#c89211]">Student Portal Login</a>
