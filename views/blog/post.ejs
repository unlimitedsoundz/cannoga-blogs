<div class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section 
        class="relative overflow-hidden transition-all duration-700 ease-in-out"
        style="background-color: #0a151a;"
    >
        <div class="container mx-auto flex flex-col lg:flex-row items-center gap-4 lg:gap-12 py-6 md:py-8 px-4 sm:px-6 lg:px-8 relative z-10">
            <!-- Left Content -->
            <div class="lg:w-3/5 space-y-3 relative z-10 flex flex-col justify-center text-white">
                <h1 class="font-bold text-white text-2xl sm:text-3xl md:text-4xl leading-tight tracking-tight">
                    <%= post.title %>
                </h1>
                <p class="text-base sm:text-lg text-neutral-200 max-w-xl leading-relaxed">
                    <%= post.excerpt || 'Read this insightful blog post from Cannoga College student ambassadors.' %>
                </p>
                <p class="text-xs sm:text-sm text-neutral-400 font-medium">
                    Published on <%= formatToDDMMYYYY(post.publishDate) %>
                </p>
            </div>

            <!-- Right Image -->
            <div class="lg:w-2/5 w-full relative z-20 order-first lg:order-none h-[180px] sm:h-[220px] lg:h-[240px] rounded-xl overflow-hidden shadow-lg">
                <img
                    src="<%= post.imageUrl || '/images/1775817359452-019d76f5-cb93-7e9a-8515-61a71c69fa56.png' %>"
                    alt="<%= post.title %>"
                    class="object-cover w-full h-full object-center hover:scale-105 transition-transform duration-500"
                />
            </div>
        </div>
        <!-- Decorative background elements -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/20 to-transparent pointer-events-none"></div>
    </section>

    <!-- Breadcrumb Navigation -->
    <div class="container mx-auto px-4 py-6 max-w-4xl">
        <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-sm">
            <a
                href="/"
                class="text-neutral-500 hover:text-black transition-colors font-medium"
            >
                Home
            </a>
            <span class="text-neutral-400">/</span>
            <a
                href="/"
                class="text-neutral-500 hover:text-black transition-colors font-medium"
            >
                Blog
            </a>
            <span class="text-neutral-400">/</span>
            <span class="text-neutral-900 font-medium truncate max-w-xs">
                <%= post.title %>
            </span>
        </nav>

        <!-- Compact back navigation -->
        <div class="mt-4">
            <a href="/" class="text-neutral-600 hover:text-black font-semibold inline-flex items-center gap-2 transition-colors group">
                ←
                <span>Back to Blog</span>
            </a>
        </div>
    </div>

    <div class="mx-auto px-8 py-8 md:py-16 max-w-4xl w-full">
        <div class="blog-content">
            <%- post.content %>
        </div>

        <!-- Categories -->
        <div class="mt-12 pt-8 border-t border-neutral-100">
            <div class="flex flex-wrap gap-2">
                <% (post.categories && post.categories.length > 0 ? post.categories : [
                    'Student Life',
                    'Canada',
                    'University',
                    'Education',
                    'International Students'
                ]).forEach(category => { %>
                    <a
                        href="/?category=<%= encodeURIComponent(category) %>"
                        class="inline-block bg-[#0a151a] text-white text-xs font-medium px-3.5 py-1 rounded-full uppercase tracking-wide hover:bg-slate-800 transition-colors"
                    >
                        <%= category %>
                    </a>
                <% }); %>
            </div>
        </div>

        <!-- Keep Reading -->
        <% if (otherBlogs && otherBlogs.length > 0) { %>
            <% 
                const keepReadingPalettes = [
                    { bgColor: 'bg-[#6366f1]', waveColor: '#3730a3' }, // Electric Indigo
                    { bgColor: 'bg-[#ec4899]', waveColor: '#831843' }, // Vibrant Hot Pink
                    { bgColor: 'bg-[#10b981]', waveColor: '#064e3b' }, // Electric Emerald
                    { bgColor: 'bg-[#f97316]', waveColor: '#7c2d12' }, // Vibrant Bright Orange
                ];
            %>
            <div class="mt-16 pt-10">
                <h3 class="text-left text-xs font-bold uppercase tracking-widest text-neutral-500 mb-6">Keep Reading</h3>
                <div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
                        <% otherBlogs.forEach((blog, idx) => { 
                            const palette = keepReadingPalettes[idx % keepReadingPalettes.length];
                        %>
                            <a 
                                href="/<%= blog.slug %>" 
                                class="block w-full p-3 rounded-md <%= palette.bgColor %> no-underline overflow-hidden group hover:brightness-105 transition-all duration-300 flex flex-col justify-between"
                            >
                                <!-- Top Image with Wavy Cutout -->
                                <div class="relative aspect-[16/9] w-full overflow-hidden rounded-sm bg-black/10">
                                    <img
                                        src="<%= blog.imageUrl || '/images/admissions/events.jpg' %>"
                                        alt="<%= blog.title %>"
                                        class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                                    />
                                    
                                    <!-- Organic Wavy Edge overlay at BOTTOM of image -->
                                    <div
                                        class="absolute bottom-[-18px] left-0 right-0 h-12 overflow-hidden leading-none z-10 pointer-events-none animate-wave-schools"
                                        style="animation-delay: <%= (idx * 0.4) %>s;"
                                    >
                                        <svg
                                            viewBox="0 0 1440 200"
                                            preserveAspectRatio="none"
                                            class="w-full h-full fill-current block"
                                            style="color: <%= palette.waveColor %>;"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M0,45 C320,105 640,-15 960,75 C1200,115 1380,45 1440,65 V200 H0 Z"
                                            />
                                        </svg>
                                    </div>
                                </div>

                                <!-- Card Content -->
                                <div class="pt-4 pb-2 px-2 flex flex-col justify-between flex-1 gap-3 text-white">
                                    <div class="space-y-2">
                                        <div class="text-[11px] uppercase tracking-wider text-white/80 font-bold">
                                            <%= formatToDDMMYYYY(blog.publishDate) %>
                                        </div>

                                        <h3 class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight leading-tight">
                                            <%= blog.title %>
                                        </h3>

                                        <p class="text-xs sm:text-sm font-medium text-white/90 leading-relaxed line-clamp-2">
                                            <%= blog.excerpt || blog.content.replace(/<[^>]*>/g, '').slice(0, 120) %>
                                        </p>
                                    </div>

                                    <div class="pt-3 flex items-end justify-between gap-4 mt-auto">
                                        <span class="text-[11px] font-bold uppercase tracking-wider text-white">
                                            Read Story
                                        </span>

                                        <div
                                            class="shrink-0 mb-0.5 animate-arrow-schools group-hover:scale-110 transition-transform"
                                            style="animation-delay: <%= (idx * 0.4) %>s;"
                                        >
                                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Post Navigation -->
        <% if (prevBlog || nextBlog) { %>
            <div class="mt-16 pt-10">
                <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-6">More Posts</h3>
                <div class="flex justify-between items-center">
                    <% if (prevBlog) { %>
                        <a
                            href="/<%= prevBlog.slug %>"
                            class="flex items-center gap-2 text-neutral-600 hover:text-black transition-colors group no-underline"
                        >
                            ←
                            <div class="text-left">
                                <div class="text-xs font-bold uppercase tracking-widest text-neutral-400">Previous</div>
                                <div class="text-sm font-semibold line-clamp-1"><%= prevBlog.title %></div>
                            </div>
                        </a>
                    <% } else { %>
                        <div></div>
                    <% } %>
                    <% if (nextBlog) { %>
                        <a
                            href="/<%= nextBlog.slug %>"
                            class="flex items-center gap-2 text-neutral-600 hover:text-black transition-colors group text-right no-underline"
                        >
                            <div class="text-right">
                                <div class="text-xs font-bold uppercase tracking-widest text-neutral-400">Next</div>
                                <div class="text-sm font-semibold line-clamp-1"><%= nextBlog.title %></div>
                            </div>
                            →
                        </a>
                    <% } else { %>
                        <div></div>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- Related Links -->
        <div class="mt-16 pt-10">
            <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-6">Related Links</h3>
            <div class="grid md:grid-cols-3 gap-4">
                <a href="https://cannogacollege.ca/admissions/application-process" class="bg-neutral-50 p-5 rounded-2xl hover:bg-neutral-100 transition-colors group">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">How to Apply</h4>
                    <p class="text-xs text-neutral-500">Step-by-step application guide.</p>
                </a>
                <a href="https://cannogacollege.ca/studies" class="bg-neutral-50 p-5 rounded-2xl hover:bg-neutral-100 transition-colors group">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">Explore Programmes</h4>
                    <p class="text-xs text-neutral-500">Browse all degree programmes.</p>
                </a>
                <a href="https://cannogacollege.ca/student-guide/international" class="bg-neutral-50 p-5 rounded-2xl hover:bg-neutral-100 transition-colors group">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">International Students</h4>
                    <p class="text-xs text-neutral-500">Visa, housing, and arrival info.</p>
                </a>
            </div>
        </div>
    </div>
</div>