<div class="min-h-screen bg-white">
    <!-- Hero Carousel -->
    <div class="w-full container mx-auto px-4 sm:px-6 lg:px-8 pt-0">
        <section id="hero-carousel" class="relative overflow-hidden text-white min-h-[360px] lg:h-[400px] flex items-center rounded-2xl mt-4">
            <!-- Slide 1 -->
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-100 z-10 pointer-events-auto">
                <div class="absolute inset-0 w-full h-full bg-[#0a151a]">
                    <img src="/images/home-carousel-1.png" alt="Cannoga College Ottawa" class="object-cover object-center w-full h-full opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-[1]"></div>
                </div>
                <div class="w-full h-full relative z-20 flex items-center justify-start px-6 md:px-10 lg:px-12 py-8 lg:py-12">
                    <div class="w-full lg:w-3/5 flex flex-col space-y-6 text-white text-left items-start">
                        <div class="space-y-4">
                            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                                The future you want is yours to make
                            </h1>
                            <p class="text-lg lg:text-xl text-white max-w-xl font-medium leading-relaxed mr-auto">
                                With practical, hands-on learning, Cannoga College prepares you for success. Explore our programs and discover your potential in the heart of Ottawa, Ontario, Canada.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="https://cannogacollege.ca/admissions" class="inline-flex items-center gap-2 bg-white hover:bg-neutral-100 text-[#0a151a] font-bold text-sm tracking-wider uppercase px-8 py-4 no-underline rounded-sm transition-colors shadow-md">
                                <span>Start your application</span>
                                <svg class="w-4 h-4 text-[#c89211]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2 (Blog Ambassador Focus) -->
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0 pointer-events-none">
                <div class="absolute inset-0 w-full h-full bg-[#0a151a]">
                    <img src="/images/home-carousel-2.png" alt="Cannoga College Student Ambassadors" class="object-cover object-center w-full h-full opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-[1]"></div>
                </div>
                <div class="w-full h-full relative z-20 flex items-center justify-start px-6 md:px-10 lg:px-12 py-8 lg:py-12">
                    <div class="w-full lg:w-3/5 flex flex-col space-y-6 text-white text-left items-start">
                        <div class="space-y-4">
                            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                                Student Ambassadors Blog
                            </h1>
                            <p class="text-lg lg:text-xl text-white max-w-xl font-medium leading-relaxed mr-auto">
                                Stories and insights from Cannoga College student ambassadors sharing their experiences studying and living in Ottawa, Ontario, Canada.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="#blog-posts" class="inline-flex items-center gap-2 bg-white hover:bg-neutral-100 text-[#0a151a] font-bold text-sm tracking-wider uppercase px-8 py-4 no-underline rounded-sm transition-colors shadow-md">
                                <span>Read Student Stories</span>
                                <svg class="w-4 h-4 text-[#c89211]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0 pointer-events-none">
                <div class="absolute inset-0 w-full h-full bg-[#0a151a]">
                    <img src="/images/home-carousel-3.png" alt="State-of-the-art campus in Ottawa" class="object-cover object-center w-full h-full opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-[1]"></div>
                </div>
                <div class="w-full h-full relative z-20 flex items-center justify-start px-6 md:px-10 lg:px-12 py-8 lg:py-12">
                    <div class="w-full lg:w-3/5 flex flex-col space-y-6 text-white text-left items-start">
                        <div class="space-y-4">
                            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                                State-of-the-art campus in Ottawa
                            </h1>
                            <p class="text-lg lg:text-xl text-white max-w-xl font-medium leading-relaxed mr-auto">
                                Enjoy advanced facilities, modern laboratories, and collaborative workspaces designed to foster innovation and learning.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="https://cannogacollege.ca/contact" class="inline-flex items-center gap-2 bg-white hover:bg-neutral-100 text-[#0a151a] font-bold text-sm tracking-wider uppercase px-8 py-4 no-underline rounded-sm transition-colors shadow-md">
                                <span>Book a campus visit</span>
                                <svg class="w-4 h-4 text-[#c89211]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Manual Controls -->
            <button id="hero-prev" class="absolute left-6 top-1/2 transform -translate-y-1/2 z-30 rounded-full bg-[#0f2027]/60 hover:bg-[#0f2027] w-12 h-12 flex items-center justify-center text-white transition-colors border-0" aria-label="Previous slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button id="hero-next" class="absolute right-6 top-1/2 transform -translate-y-1/2 z-30 rounded-full bg-[#0f2027]/60 hover:bg-[#0f2027] w-12 h-12 flex items-center justify-center text-white transition-colors border-0" aria-label="Next slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
            </button>

            <!-- Dots Indicator -->
            <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 z-30 flex gap-2.5">
                <button class="hero-dot w-3.5 h-3.5 rounded-full transition-all duration-300 border-0 bg-white scale-110" aria-label="Slide 1"></button>
                <button class="hero-dot w-3.5 h-3.5 rounded-full transition-all duration-300 border-0 bg-white/40 hover:bg-white/70" aria-label="Slide 2"></button>
                <button class="hero-dot w-3.5 h-3.5 rounded-full transition-all duration-300 border-0 bg-white/40 hover:bg-white/70" aria-label="Slide 3"></button>
            </div>
        </section>
    </div>

    <!-- Breadcrumb Navigation -->
    <div class="container mx-auto px-4 py-6 max-w-6xl">
        <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-sm">
            <a href="https://cannogacollege.ca/" class="text-neutral-500 hover:text-black transition-colors font-medium">Home</a>
            <span class="text-neutral-400">/</span>
            <span class="text-neutral-900 font-medium">Blog</span>
        </nav>
    </div>

    <!-- Main Content Grid -->
    <div id="blog-posts" class="container mx-auto px-4 py-8 md:py-16 max-w-6xl">
        <% if (category) { %>
            <div class="mb-8">
                <h2 class="text-2xl font-bold mb-4 text-neutral-900">Posts in category "<%= category %>"</h2>
                <a href="/" class="text-neutral-600 hover:text-black underline">← Back to all posts</a>
            </div>
        <% } %>

        <!-- Search and Filter -->
        <div class="mb-8 space-y-4">
            <!-- Search Bar -->
            <div class="max-w-md pb-6 md:pb-8">
                <form method="GET" class="flex gap-2">
                    <input
                        type="text"
                        name="search"
                        value="<%= search || '' %>"
                        placeholder="Search blog posts..."
                        class="flex-1 px-4 py-2 bg-neutral-50 border-0 rounded-xl focus:bg-white focus:outline-none text-sm transition-all shadow-xs"
                    />
                    <% if (category) { %>
                        <input type="hidden" name="category" value="<%= category %>" />
                    <% } %>
                    <button type="submit" class="px-6 py-2 bg-[#0a151a] text-white rounded-xl hover:bg-slate-800 transition-colors font-bold text-sm">
                        Search
                    </button>
                </form>
            </div>

            <!-- Category Filter -->
            <% if (categories && categories.length > 0) { %>
            <div class="mb-8">
                <h3 class="text-lg font-bold mb-4 text-neutral-900">Filter by Category</h3>
                <div class="flex flex-wrap gap-2">
            <a
                href="/"
                class="inline-block text-xs font-semibold px-4 py-2 rounded-full capitalize transition-colors <%= !category ? 'bg-[#0a151a] text-white' : 'bg-neutral-100 text-neutral-700 hover:bg-neutral-200' %>"
            >
                All Posts
            </a>
                    <% categories.forEach(cat => { %>
                        <a
                            href="/?category=<%= encodeURIComponent(cat) %>"
                            class="inline-block text-xs font-semibold px-4 py-2 rounded-full capitalize transition-colors <%= category === cat ? 'bg-[#0a151a] text-white' : 'bg-neutral-100 text-neutral-700 hover:bg-neutral-200' %>"
                        >
                            <%= cat %>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <% if (posts.length === 0) { %>
            <div class="text-center py-16">
                <h2 class="text-2xl font-bold mb-4 text-neutral-900">No posts found</h2>
                <p class="text-neutral-600 mb-8">There are no blog posts available at the moment.</p>
                <a href="/" class="bg-[#0a151a] text-white px-6 py-3 font-bold hover:bg-slate-800 transition-colors rounded-xl">Back to Blog</a>
            </div>
        <% } else { %>
            <% 
                const colorPalettes = [
                    { bgColor: 'bg-[#6366f1]', borderColor: 'border-[#6366f1]', waveColor: '#3730a3' }, // Electric Indigo
                    { bgColor: 'bg-[#ec4899]', borderColor: 'border-[#ec4899]', waveColor: '#831843' }, // Vibrant Hot Pink
                    { bgColor: 'bg-[#10b981]', borderColor: 'border-[#10b981]', waveColor: '#064e3b' }, // Electric Emerald
                    { bgColor: 'bg-[#f97316]', borderColor: 'border-[#f97316]', waveColor: '#7c2d12' }, // Vibrant Bright Orange
                    { bgColor: 'bg-[#06b6d4]', borderColor: 'border-[#06b6d4]', waveColor: '#164e63' }, // Electric Cyan
                    { bgColor: 'bg-[#8b5cf6]', borderColor: 'border-[#8b5cf6]', waveColor: '#4c1d95' }, // Vibrant Deep Purple
                    { bgColor: 'bg-[#ef4444]', borderColor: 'border-[#ef4444]', waveColor: '#7f1d1d' }, // Electric Crimson
                    { bgColor: 'bg-[#84cc16]', borderColor: 'border-[#84cc16]', waveColor: '#365314' }, // Vibrant Lime Green
                ];
            %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% posts.forEach((post, idx) => { 
                    const palette = colorPalettes[idx % colorPalettes.length];
                %>
                    <div class="flex flex-col no-underline">
                        <a
                            href="/<%= post.slug %>"
                            class="block w-full p-3 sm:p-4 rounded-md <%= palette.bgColor %> <%= palette.borderColor %> border-4 no-underline overflow-hidden group hover:brightness-105 transition-all duration-300 flex flex-col h-full justify-between"
                        >
                            <!-- Card Top Image with Animated Wavy Cutout -->
                            <div class="relative aspect-[4/3] sm:aspect-[16/11] w-full overflow-hidden rounded-sm bg-black/10">
                                <img
                                    src="<%= post.imageUrl || '/images/admissions/events.jpg' %>"
                                    alt="<%= post.title %>"
                                    class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                                />

                                <!-- Category Badge in Image Top-Left -->
                                <% if (post.categories && post.categories.length > 0) { %>
                                    <div class="absolute top-3 left-3 z-20">
                                        <span class="px-3 py-1 text-[11px] font-black uppercase tracking-wider bg-black/70 backdrop-blur-xs text-white rounded-full">
                                            <%= post.categories[0] %>
                                        </span>
                                    </div>
                                <% } %>

                                <!-- Organic Wavy Edge overlay at BOTTOM of image with smooth wave animation -->
                                <div
                                    class="absolute bottom-[-24px] left-0 right-0 h-16 sm:h-24 overflow-hidden leading-none z-10 pointer-events-none animate-wave-schools"
                                    style="animation-delay: <%= (idx * 0.4) %>s;"
                                >
                                    <svg
                                        viewBox="0 0 1440 200"
                                        preserveAspectRatio="none"
                                        class="w-full h-full fill-current block"
                                        style="color: <%= palette.waveColor %>;"
                                    >
                                        <path
                                            fill="currentColor"
                                            d="M0,45 C320,105 640,-15 960,75 C1200,115 1380,45 1440,65 V200 H0 Z"
                                        />
                                    </svg>
                                </div>
                            </div>

                            <!-- Card Bottom Solid Color Content -->
                            <div class="pt-6 pb-4 px-3 sm:px-5 flex flex-col justify-between flex-1 gap-4 text-white">
                                <div class="space-y-3">
                                    <div class="text-[12px] uppercase tracking-wider text-white/80 font-bold">
                                        <%= formatToDDMMYYYY(post.publishDate) %>
                                    </div>

                                    <h3 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight leading-[1.05]">
                                        <%= post.title %>
                                    </h3>

                                    <p class="text-sm font-medium text-white/90 leading-relaxed line-clamp-3">
                                        <%= post.excerpt || post.content.replace(/<[^>]*>/g, '').substring(0, 180) %>
                                    </p>
                                </div>

                                <div class="pt-4 flex items-end justify-between gap-4 border-t border-white/20 mt-auto">
                                    <span class="text-xs font-bold uppercase tracking-wider text-white">
                                        Read Story
                                    </span>

                                    <!-- Thick Arrow Icon in Bottom Right with Floating Animation -->
                                    <div
                                        class="shrink-0 mb-0.5 animate-arrow-schools group-hover:scale-110 transition-transform"
                                        style="animation-delay: <%= (idx * 0.4) %>s;"
                                    >
                                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>

            <% if (totalPages > 1) { %>
                <div class="flex justify-center mt-12">
                    <nav class="flex items-center space-x-2">
                        <% if (currentPage > 1) { %>
                            <a href="<%= `/?${category ? `category=${encodeURIComponent(category)}&` : ''}${search ? `search=${encodeURIComponent(search)}&` : ''}page=${currentPage - 1}` %>" class="px-4 py-2 bg-neutral-100 text-neutral-700 rounded-lg hover:bg-neutral-200 transition-colors text-sm font-semibold">
                                Previous
                            </a>
                        <% } %>

                        <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                            <a href="<%= `/?${category ? `category=${encodeURIComponent(category)}&` : ''}${search ? `search=${encodeURIComponent(search)}&` : ''}page=${i}` %>" class="<%= i === currentPage ? 'px-4 py-2 bg-[#0a151a] text-white rounded-lg text-sm font-semibold' : 'px-4 py-2 bg-neutral-100 text-neutral-700 rounded-lg hover:bg-neutral-200 transition-colors text-sm font-semibold' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="<%= `/?${category ? `category=${encodeURIComponent(category)}&` : ''}${search ? `search=${encodeURIComponent(search)}&` : ''}page=${currentPage + 1}` %>" class="px-4 py-2 bg-neutral-100 text-neutral-700 rounded-lg hover:bg-neutral-200 transition-colors text-sm font-semibold">
                                Next
                            </a>
                        <% } %>
                    </nav>
                </div>
            <% } %>
        <% } %>

        <!-- Related Links -->
        <div class="mt-16 pt-10 border-t border-neutral-100">
            <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-6">Related Links</h3>
            <div class="grid md:grid-cols-3 gap-4">
                <a href="https://cannogacollege.ca/admissions/application-process" class="bg-neutral-50 p-5 rounded-2xl hover:bg-neutral-100 transition-colors group border-0 shadow-xs">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">How to Apply</h4>
                    <p class="text-xs text-neutral-500">Step-by-step application guide.</p>
                </a>
                <a href="https://cannogacollege.ca/studies" class="bg-neutral-50 p-5 rounded-2xl hover:bg-neutral-100 transition-colors group border-0 shadow-xs">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">Explore Programmes</h4>
                    <p class="text-xs text-neutral-500">Browse all degree programmes.</p>
                </a>
                <a href="https://cannogacollege.ca/student-guide/international" class="bg-neutral-50 p-5 rounded-2xl hover:bg-neutral-100 transition-colors group border-0 shadow-xs">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">International Students</h4>
                    <p class="text-xs text-neutral-500">Visa, housing, and arrival info.</p>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.hero-dot');
        const prevBtn = document.getElementById('hero-prev');
        const nextBtn = document.getElementById('hero-next');
        let currentSlide = 0;
        let slideInterval;

        function goToSlide(index) {
            slides[currentSlide].classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
            slides[currentSlide].classList.add('opacity-0', 'z-0', 'pointer-events-none');
            dots[currentSlide].classList.remove('bg-white', 'scale-110');
            dots[currentSlide].classList.add('bg-white/40');

            currentSlide = (index + slides.length) % slides.length;

            slides[currentSlide].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            slides[currentSlide].classList.add('opacity-100', 'z-10', 'pointer-events-auto');
            dots[currentSlide].classList.remove('bg-white/40');
            dots[currentSlide].classList.add('bg-white', 'scale-110');
        }

        function nextSlide() {
            goToSlide(currentSlide + 1);
        }

        function prevSlide() {
            goToSlide(currentSlide - 1);
        }

        function startTimer() {
            slideInterval = setInterval(nextSlide, 6000);
        }

        function resetTimer() {
            clearInterval(slideInterval);
            startTimer();
        }

        if (prevBtn && nextBtn && slides.length > 0) {
            prevBtn.addEventListener('click', () => { prevSlide(); resetTimer(); });
            nextBtn.addEventListener('click', () => { nextSlide(); resetTimer(); });
            dots.forEach((dot, idx) => {
                dot.addEventListener('click', () => { goToSlide(idx); resetTimer(); });
            });
            startTimer();
        }
    });
</script>