<div class="min-h-screen bg-white">
    <!-- Hero Carousel - Identical to http://localhost:3000/ Hero -->
    <div class="w-full container mx-auto px-4 sm:px-6 lg:px-8 pt-0">
        <section id="hero-carousel" class="relative overflow-hidden text-white min-h-[450px] lg:h-[500px] flex items-center border-b border-[#0f2027]/10 rounded-xl mt-4">
            <!-- Slide 1 -->
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-100 z-10 pointer-events-auto">
                <div class="absolute inset-0 w-full h-full bg-[#0a151a]">
                    <img src="/images/home-carousel-1.png" alt="Cannoga College Ottawa" class="object-cover object-center w-full h-full opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-[1]"></div>
                </div>
                <div class="w-full h-full relative z-20 flex items-center justify-start px-6 md:px-10 lg:px-12 py-8 lg:py-12">
                    <div class="w-full lg:w-3/5 flex flex-col space-y-6 text-white text-left items-start">
                        <div class="space-y-4">
                            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                                The future you want is yours to make
                            </h1>
                            <p class="text-lg lg:text-xl text-white max-w-xl font-medium leading-relaxed mr-auto">
                                With practical, hands-on learning, Cannoga College prepares you for success. Explore our programs and discover your potential in the heart of Ottawa, Ontario, Canada.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="https://cannogacollege.ca/admissions" class="inline-flex items-center gap-2 bg-white hover:bg-neutral-100 text-[#0a151a] font-bold text-sm tracking-wider uppercase px-8 py-4 no-underline rounded-sm transition-colors shadow-md">
                                <span>Start your application</span>
                                <svg class="w-4 h-4 text-[#c89211]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2 (Blog Ambassador Focus) -->
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0 pointer-events-none">
                <div class="absolute inset-0 w-full h-full bg-[#0a151a]">
                    <img src="/images/home-carousel-2.png" alt="Cannoga College Student Ambassadors" class="object-cover object-center w-full h-full opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-[1]"></div>
                </div>
                <div class="w-full h-full relative z-20 flex items-center justify-start px-6 md:px-10 lg:px-12 py-8 lg:py-12">
                    <div class="w-full lg:w-3/5 flex flex-col space-y-6 text-white text-left items-start">
                        <div class="space-y-4">
                            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                                Student Ambassadors Blog
                            </h1>
                            <p class="text-lg lg:text-xl text-white max-w-xl font-medium leading-relaxed mr-auto">
                                Stories and insights from Cannoga College student ambassadors sharing their experiences studying and living in Ottawa, Ontario, Canada.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="#blog-posts" class="inline-flex items-center gap-2 bg-white hover:bg-neutral-100 text-[#0a151a] font-bold text-sm tracking-wider uppercase px-8 py-4 no-underline rounded-sm transition-colors shadow-md">
                                <span>Read Student Stories</span>
                                <svg class="w-4 h-4 text-[#c89211]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-0 z-0 pointer-events-none">
                <div class="absolute inset-0 w-full h-full bg-[#0a151a]">
                    <img src="/images/home-carousel-3.png" alt="State-of-the-art campus in Ottawa" class="object-cover object-center w-full h-full opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30 z-[1]"></div>
                </div>
                <div class="w-full h-full relative z-20 flex items-center justify-start px-6 md:px-10 lg:px-12 py-8 lg:py-12">
                    <div class="w-full lg:w-3/5 flex flex-col space-y-6 text-white text-left items-start">
                        <div class="space-y-4">
                            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
                                State-of-the-art campus in Ottawa
                            </h1>
                            <p class="text-lg lg:text-xl text-white max-w-xl font-medium leading-relaxed mr-auto">
                                Enjoy advanced facilities, modern laboratories, and collaborative workspaces designed to foster innovation and learning.
                            </p>
                        </div>
                        <div class="pt-2">
                            <a href="https://cannogacollege.ca/contact" class="inline-flex items-center gap-2 bg-white hover:bg-neutral-100 text-[#0a151a] font-bold text-sm tracking-wider uppercase px-8 py-4 no-underline rounded-sm transition-colors shadow-md">
                                <span>Book a campus visit</span>
                                <svg class="w-4 h-4 text-[#c89211]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Manual Controls -->
            <button id="hero-prev" class="absolute left-6 top-1/2 transform -translate-y-1/2 z-30 rounded-full bg-[#0f2027]/60 hover:bg-[#0f2027] w-12 h-12 flex items-center justify-center text-white transition-colors border border-white/20" aria-label="Previous slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button id="hero-next" class="absolute right-6 top-1/2 transform -translate-y-1/2 z-30 rounded-full bg-[#0f2027]/60 hover:bg-[#0f2027] w-12 h-12 flex items-center justify-center text-white transition-colors border border-white/20" aria-label="Next slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/></svg>
            </button>

            <!-- Dots Indicator -->
            <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 z-30 flex gap-2.5">
                <button class="hero-dot w-3.5 h-3.5 rounded-full transition-all duration-300 border-2 border-white bg-white scale-110" aria-label="Slide 1"></button>
                <button class="hero-dot w-3.5 h-3.5 rounded-full transition-all duration-300 border-2 border-white bg-transparent hover:bg-white/30" aria-label="Slide 2"></button>
                <button class="hero-dot w-3.5 h-3.5 rounded-full transition-all duration-300 border-2 border-white bg-transparent hover:bg-white/30" aria-label="Slide 3"></button>
            </div>
        </section>
    </div>

    <!-- Breadcrumb Navigation -->
    <div class="container mx-auto px-4 py-6 max-w-6xl">
        <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-sm">
            <a href="https://cannogacollege.ca/" class="text-neutral-500 hover:text-black transition-colors font-medium">Home</a>
            <span class="text-neutral-400">/</span>
            <span class="text-neutral-900 font-medium">Blog</span>
        </nav>

        <div class="mt-4">
            <a href="https://cannogacollege.ca/" class="text-neutral-600 hover:text-black font-semibold inline-flex items-center gap-2 transition-colors group">
                ←
                <span>Back to Cannoga College Main Site</span>
                <span class="text-neutral-400">•</span>
                <span class="text-neutral-500 text-xs uppercase tracking-wide">Ottawa Campus</span>
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div id="blog-posts" class="container mx-auto px-4 py-8 md:py-16 max-w-6xl">
        <% if (category) { %>
            <div class="mb-8">
                <h2 class="text-2xl font-bold mb-4">Posts in category "<%= category %>"</h2>
                <a href="/" class="text-neutral-600 hover:text-black underline">← Back to all posts</a>
            </div>
        <% } %>

        <!-- Search and Filter -->
        <div class="mb-8 space-y-4">
            <!-- Search Bar -->
            <div class="max-w-md pb-6 md:pb-8">
                <form method="GET" class="flex gap-2">
                    <input
                        type="text"
                        name="search"
                        value="<%= search || '' %>"
                        placeholder="Search blog posts..."
                        class="flex-1 px-4 py-2 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-black focus:border-transparent"
                    />
                    <% if (category) { %>
                        <input type="hidden" name="category" value="<%= category %>" />
                    <% } %>
                    <button type="submit" class="px-6 py-2 bg-[#0a151a] text-white rounded-lg hover:bg-slate-800 transition-colors font-bold text-sm">
                        Search
                    </button>
                </form>
            </div>

            <!-- Category Filter -->
            <% if (categories && categories.length > 0) { %>
            <div class="mb-8">
                <h3 class="text-lg font-bold mb-4">Filter by Category</h3>
                <div class="flex flex-wrap gap-2">
            <a
                href="/"
                class="inline-block text-sm px-4 py-2 rounded-md capitalize transition-colors <%= !category ? 'bg-neutral-800 text-white ring-2 ring-black ring-offset-2' : 'bg-black text-white hover:bg-neutral-800' %>"
            >
                All Posts
            </a>
                    <% categories.forEach(cat => { %>
                        <a
                            href="/?category=<%= encodeURIComponent(cat) %>"
                            class="inline-block text-sm px-4 py-2 rounded-md capitalize transition-colors <%= category === cat ? 'bg-neutral-800 text-white ring-2 ring-black ring-offset-2' : 'bg-black text-white hover:bg-neutral-800' %>"
                        >
                            <%= cat %>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <% if (posts.length === 0) { %>
            <div class="text-center py-16">
                <h2 class="text-2xl font-bold mb-4">No posts found</h2>
                <p class="text-neutral-600 mb-8">There are no blog posts available at the moment.</p>
                <a href="/" class="bg-[#0a151a] text-white px-6 py-3 font-bold hover:bg-slate-800 transition-colors rounded-lg">Back to Blog</a>
            </div>
        <% } else { %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% posts.forEach(post => { %>
                    <a
                        href="/<%= post.slug %>"
                        class="flex flex-col bg-neutral-100 overflow-hidden group hover:bg-neutral-200 transition-colors h-full rounded-xl shadow-sm border border-neutral-200"
                    >
                        <div class="aspect-[16/9] relative overflow-hidden bg-neutral-200">
                            <img
                                src="<%= post.imageUrl || '/images/admissions/events.jpg' %>"
                                alt="<%= post.title %>"
                                class="object-cover group-hover:opacity-80 transition-opacity duration-300 w-full h-full"
                            />
                            <div class="absolute top-4 left-4">
                                <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest bg-[#0a151a] text-white rounded">
                                    Blog
                                </span>
                            </div>
                        </div>

                        <div class="p-6 flex flex-col flex-1">
                            <div class="flex items-center gap-2 text-[13px] uppercase tracking-widest text-black mb-3">
                                <span><%= formatToDDMMYYYY(post.publishDate) %></span>
                            </div>

                            <h2 class="text-xl font-bold mb-3 text-neutral-900 group-hover:underline leading-tight">
                                <%= post.title %>
                            </h2>

                            <p class="text-black text-sm mb-4">
                                <%= post.excerpt || post.content.replace(/<[^>]*>/g, '').substring(0, 300) %>
                                <% if ((post.excerpt || post.content.replace(/<[^>]*>/g, '')).length > 300) { %>
                                    ...
                                <% } %>
                            </p>

                            <% if (post.categories && post.categories.length > 0) { %>
                                <div class="flex flex-wrap gap-1 mb-3">
                                    <% post.categories.slice(0, 3).forEach(category => { %>
                                        <a
                                            href="/?category=<%= encodeURIComponent(category) %>"
                                            class="inline-block bg-[#0a151a] text-white text-xs px-2 py-1 rounded-full capitalize"
                                        >
                                            <%= category %>
                                        </a>
                                    <% }); %>
                                </div>
                            <% } %>

                            <div class="mt-auto flex items-center text-xs font-bold uppercase tracking-wider text-black">
                                Read more →
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>

            <% if (totalPages > 1) { %>
                <div class="flex justify-center mt-12">
                    <nav class="flex items-center space-x-2">
                        <% if (currentPage > 1) { %>
                            <a href="<%= `/?${category ? `category=${encodeURIComponent(category)}&` : ''}${search ? `search=${encodeURIComponent(search)}&` : ''}page=${currentPage - 1}` %>" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors">
                                Previous
                            </a>
                        <% } %>

                        <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                            <a href="<%= `/?${category ? `category=${encodeURIComponent(category)}&` : ''}${search ? `search=${encodeURIComponent(search)}&` : ''}page=${i}` %>" class="<%= i === currentPage ? 'px-4 py-2 bg-[#0a151a] text-white rounded' : 'px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="<%= `/?${category ? `category=${encodeURIComponent(category)}&` : ''}${search ? `search=${encodeURIComponent(search)}&` : ''}page=${currentPage + 1}` %>" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors">
                                Next
                            </a>
                        <% } %>
                    </nav>
                </div>
            <% } %>
        <% } %>

        <!-- Related Links -->
        <div class="mt-16 pt-10 border-t border-neutral-200">
            <h3 class="text-sm font-bold uppercase tracking-widest text-neutral-900 mb-6">Related Links</h3>
            <div class="grid md:grid-cols-3 gap-4">
                <a href="https://cannogacollege.ca/admissions/application-process" class="bg-neutral-50 p-5 rounded-xl hover:bg-neutral-100 transition-colors group border border-neutral-200">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">How to Apply</h4>
                    <p class="text-xs text-neutral-500">Step-by-step application guide.</p>
                </a>
                <a href="https://cannogacollege.ca/studies" class="bg-neutral-50 p-5 rounded-xl hover:bg-neutral-100 transition-colors group border border-neutral-200">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">Explore Programmes</h4>
                    <p class="text-xs text-neutral-500">Browse all degree programmes.</p>
                </a>
                <a href="https://cannogacollege.ca/student-guide/international" class="bg-neutral-50 p-5 rounded-xl hover:bg-neutral-100 transition-colors group border border-neutral-200">
                    <h4 class="font-bold text-neutral-900 mb-1 group-hover:underline text-sm">International Students</h4>
                    <p class="text-xs text-neutral-500">Visa, housing, and arrival info.</p>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.hero-dot');
        const prevBtn = document.getElementById('hero-prev');
        const nextBtn = document.getElementById('hero-next');
        let currentSlide = 0;
        let slideInterval;

        function goToSlide(index) {
            slides[currentSlide].classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
            slides[currentSlide].classList.add('opacity-0', 'z-0', 'pointer-events-none');
            dots[currentSlide].classList.remove('bg-white', 'scale-110');
            dots[currentSlide].classList.add('bg-transparent');

            currentSlide = (index + slides.length) % slides.length;

            slides[currentSlide].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            slides[currentSlide].classList.add('opacity-100', 'z-10', 'pointer-events-auto');
            dots[currentSlide].classList.remove('bg-transparent');
            dots[currentSlide].classList.add('bg-white', 'scale-110');
        }

        function nextSlide() {
            goToSlide(currentSlide + 1);
        }

        function prevSlide() {
            goToSlide(currentSlide - 1);
        }

        function startTimer() {
            slideInterval = setInterval(nextSlide, 6000);
        }

        function resetTimer() {
            clearInterval(slideInterval);
            startTimer();
        }

        if (prevBtn && nextBtn && slides.length > 0) {
            prevBtn.addEventListener('click', () => { prevSlide(); resetTimer(); });
            nextBtn.addEventListener('click', () => { nextSlide(); resetTimer(); });
            dots.forEach((dot, idx) => {
                dot.addEventListener('click', () => { goToSlide(idx); resetTimer(); });
            });
            startTimer();
        }
    });
</script>